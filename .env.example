# ╔═══════════════════════════════════════════════════════╗
# ║  VastuCart Ecommerce - Environment Variables         ║
# ╚═══════════════════════════════════════════════════════╝
# Copy to .env and fill in production values.

# ─── Core Secrets (CHANGE THESE IN PRODUCTION!) ───────
JWT_SECRET=supersecret-change-in-production
COOKIE_SECRET=supersecret-change-in-production

# ─── CORS ─────────────────────────────────────────────
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3000,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# ─── Public URLs (REQUIRED in production) ────────────
# BACKEND_URL is read by GMC/Meta status routes to build feed URLs and by the
# support-ticket emailer for the admin deep-link. If unset in production, the
# code refuses to start instead of silently pointing at the wrong domain.
BACKEND_URL=http://localhost:9000
STORE_URL=http://localhost:3000
SUPPORT_EMAIL=support@vastucart.in

# ─── Traefik / Coolify Routing ───────────────────────
# Coolify uses these to build Host() rules for the backend + frontend services.
BACKEND_DOMAIN=sapi.vastucart.in
FRONTEND_DOMAIN=store.vastucart.in

# ─── Stripe ───────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=

# ─── PayPal ───────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ─── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── MinIO / S3 Storage ──────────────────────────────
# S3_ENDPOINT is the internal cluster URL for uploads (write path).
# S3_FILE_URL is the public URL prefix the storefront serves images from.
S3_FILE_URL=http://localhost:9002/medusa-uploads
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=medusa-uploads

# ─── PostHog Analytics ───────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Google Analytics (GA4) ──────────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ─── Algolia Search ──────────────────────────────────
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_KEY=
ALGOLIA_PRODUCT_INDEX_NAME=products

# ─── VastuCart Publishable Key ──────────────────────
# Get this from the admin panel after first setup. Used by the storefront
# (NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY) and the publishable-key middleware.
MEDUSA_PUBLISHABLE_KEY=

# ─── Transactional Email (Resend) ───────────────────
# RESEND_API_KEY enables outbound order confirmations / password resets /
# abandoned-cart recovery. Without it, notifications fall back to local-only
# and no real emails go out.
RESEND_API_KEY=
EMAIL_FROM=VastuCart <orders@vastucart.in>

# ─── Error Monitoring (Sentry, optional) ────────────
# When SENTRY_DSN is set AND @sentry/node is installed in the backend, all
# captureException() calls forward to Sentry in addition to structured-JSON
# stdout logs. Without it, errors still go to stdout (Coolify captures it).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
